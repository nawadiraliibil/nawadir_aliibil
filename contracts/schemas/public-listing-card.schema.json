{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nawadiraliibil.example/contracts/schemas/public-listing-card.schema.json",
  "title": "صف من public_listing_cards",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "listing_id",
    "owner_id",
    "owner_display_name",
    "title",
    "offer_type",
    "price",
    "auction_starts_at",
    "auction_passed",
    "breed_id",
    "breed_name_ar",
    "breed_note",
    "sex",
    "age_months",
    "region_id",
    "region_name_ar",
    "city_id",
    "city_name_ar",
    "cover_bucket",
    "cover_path",
    "first_published_at",
    "visibility_updated_at",
    "public_ref"
  ],
  "properties": {
    "listing_id": {
      "type": "string",
      "format": "uuid"
    },
    "owner_id": {
      "type": "string",
      "format": "uuid"
    },
    "owner_display_name": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "offer_type": {
      "enum": [
        "FIXED_PRICE",
        "IN_PERSON_AUCTION"
      ]
    },
    "price": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    },
    "auction_starts_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "auction_passed": {
      "type": "boolean"
    },
    "breed_id": {
      "type": "integer"
    },
    "breed_name_ar": {
      "type": "string"
    },
    "breed_note": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "sex": {
      "enum": [
        "MALE",
        "FEMALE"
      ]
    },
    "age_months": {
      "type": "integer"
    },
    "region_id": {
      "type": "integer"
    },
    "region_name_ar": {
      "type": "string"
    },
    "city_id": {
      "type": "integer"
    },
    "city_name_ar": {
      "type": "string"
    },
    "cover_bucket": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "cover_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "first_published_at": {
      "type": "string",
      "format": "date-time"
    },
    "visibility_updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "public_ref": {
      "type": "string"
    }
  }
}
