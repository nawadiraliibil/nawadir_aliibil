{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nawadiraliibil.example/contracts/schemas/promotion-input.schema.json",
  "title": "p_payload في admin_save_promotion",
  "description": "النصوص تنظف من المسافات الزائدة؛ action_value يهمل مع NONE، ويوحد رقم الجوال إلى +9665XXXXXXXX.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "advertiser_name",
    "image_path",
    "action_type",
    "placements",
    "starts_at"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 2,
      "maxLength": 60
    },
    "body": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 140
        },
        {
          "type": "null"
        }
      ]
    },
    "advertiser_name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 60
    },
    "image_path": {
      "type": "string",
      "maxLength": 120,
      "pattern": "^[0-9a-f-]{36}/[A-Za-z0-9._-]+$"
    },
    "action_type": {
      "enum": [
        "URL",
        "WHATSAPP",
        "CALL",
        "NONE"
      ]
    },
    "action_value": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "placements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "HOME_FEED",
          "SEARCH_RESULTS"
        ]
      }
    },
    "region_ids": {
      "anyOf": [
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "starts_at": {
      "type": "string",
      "format": "date-time"
    },
    "ends_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "priority": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    }
  }
}
