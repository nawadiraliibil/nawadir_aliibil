{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nawadiraliibil.example/contracts/schemas/public-comment.schema.json",
  "title": "صف من public_comments",
  "description": "state=HIDDEN أو DELETED: body فارغ.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "comment_id",
    "listing_id",
    "parent_id",
    "author_id",
    "author_display_name",
    "is_owner",
    "state",
    "body",
    "edited_at",
    "created_at"
  ],
  "properties": {
    "comment_id": {
      "type": "string",
      "format": "uuid"
    },
    "listing_id": {
      "type": "string",
      "format": "uuid"
    },
    "parent_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "author_id": {
      "type": "string",
      "format": "uuid"
    },
    "author_display_name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "is_owner": {
      "type": "boolean"
    },
    "state": {
      "enum": [
        "VISIBLE",
        "HIDDEN",
        "DELETED"
      ]
    },
    "body": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "edited_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
