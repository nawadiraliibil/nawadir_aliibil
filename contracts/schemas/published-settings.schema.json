{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nawadiraliibil.example/contracts/schemas/published-settings.schema.json",
  "title": "رد get_published_settings",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "published_at",
    "settings",
    "lookups"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "published_at": {
      "type": "string",
      "format": "date-time"
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "listing",
        "media",
        "interaction",
        "rate_limits",
        "follows",
        "bump"
      ],
      "properties": {
        "listing": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "title_min",
            "title_max",
            "description_min",
            "description_max",
            "daily_new_limit",
            "open_drafts_max"
          ],
          "properties": {
            "title_min": {
              "type": "integer",
              "minimum": 1
            },
            "title_max": {
              "type": "integer",
              "minimum": 1
            },
            "description_min": {
              "type": "integer",
              "minimum": 1
            },
            "description_max": {
              "type": "integer",
              "minimum": 1
            },
            "daily_new_limit": {
              "type": "integer",
              "minimum": 1
            },
            "open_drafts_max": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "media": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "images_min",
            "images_max",
            "image_max_bytes",
            "image_mime_types",
            "video_enabled",
            "video_max_seconds",
            "video_max_bytes"
          ],
          "properties": {
            "images_min": {
              "type": "integer",
              "minimum": 1
            },
            "images_max": {
              "type": "integer",
              "minimum": 1
            },
            "image_max_bytes": {
              "type": "integer",
              "minimum": 1
            },
            "image_mime_types": {
              "type": "array",
              "minItems": 1,
              "items": {
                "enum": [
                  "image/jpeg",
                  "image/png"
                ]
              }
            },
            "video_enabled": {
              "type": "boolean"
            },
            "video_max_seconds": {
              "type": "integer",
              "minimum": 1
            },
            "video_max_bytes": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "interaction": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "message_max",
            "comment_max",
            "rating_max"
          ],
          "properties": {
            "message_max": {
              "type": "integer",
              "minimum": 1
            },
            "comment_max": {
              "type": "integer",
              "minimum": 1
            },
            "rating_max": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "rate_limits": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "messages_per_minute",
            "new_conversations_per_hour",
            "comments_per_minute",
            "reports_per_day"
          ],
          "properties": {
            "messages_per_minute": {
              "type": "integer",
              "minimum": 1
            },
            "new_conversations_per_hour": {
              "type": "integer",
              "minimum": 1
            },
            "comments_per_minute": {
              "type": "integer",
              "minimum": 1
            },
            "reports_per_day": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "follows": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "saved_searches_max",
            "followed_sellers_max"
          ],
          "properties": {
            "saved_searches_max": {
              "type": "integer",
              "minimum": 1
            },
            "followed_sellers_max": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "bump": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "interval_hours"
          ],
          "properties": {
            "interval_hours": {
              "type": "integer",
              "minimum": 24
            }
          }
        }
      }
    },
    "lookups": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "regions",
        "cities",
        "breeds"
      ],
      "properties": {
        "regions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name_ar"
            ],
            "properties": {
              "id": {
                "type": "integer"
              },
              "name_ar": {
                "type": "string"
              }
            }
          }
        },
        "cities": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "region_id",
              "name_ar"
            ],
            "properties": {
              "id": {
                "type": "integer"
              },
              "region_id": {
                "type": "integer"
              },
              "name_ar": {
                "type": "string"
              }
            }
          }
        },
        "breeds": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name_ar",
              "requires_note"
            ],
            "properties": {
              "id": {
                "type": "integer"
              },
              "name_ar": {
                "type": "string"
              },
              "requires_note": {
                "type": "boolean"
              }
            }
          }
        }
      }
    }
  }
}
