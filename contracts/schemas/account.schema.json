{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nawadiraliibil.example/contracts/schemas/account.schema.json",
  "title": "رد get_my_account وupdate_my_profile وaccept_policies",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "display_name",
    "region_id",
    "status",
    "created_at",
    "profile_complete",
    "pending_policies",
    "can_publish"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "display_name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "region_id": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "enum": [
        "ACTIVE",
        "SUSPENDED"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "profile_complete": {
      "type": "boolean"
    },
    "pending_policies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "version",
          "title"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "kind": {
            "enum": [
              "TERMS",
              "PRIVACY"
            ]
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "title": {
            "type": "string"
          }
        }
      }
    },
    "can_publish": {
      "type": "boolean"
    }
  }
}
