{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nawadiraliibil.example/contracts/schemas/listing-owner.schema.json",
  "title": "رد دوال المعلن على الإعلان",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "listing",
    "version",
    "media"
  ],
  "properties": {
    "listing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "current_version_id",
        "published_version_id",
        "has_draft",
        "first_submitted_at",
        "first_published_at",
        "last_published_at",
        "last_bumped_at",
        "next_bump_at",
        "status_changed_at",
        "created_at"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "status": {
          "enum": [
            "DRAFT",
            "UNDER_REVIEW",
            "REJECTED",
            "PUBLISHED",
            "HIDDEN",
            "ARCHIVED"
          ]
        },
        "current_version_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "published_version_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "has_draft": {
          "type": "boolean"
        },
        "first_submitted_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "first_published_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "last_published_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "last_bumped_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "next_bump_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "status_changed_at": {
          "type": "string",
          "format": "date-time"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "version": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "listing_id",
            "version_no",
            "status",
            "title",
            "description",
            "breed_id",
            "breed_note",
            "sex",
            "age_months",
            "color",
            "region_id",
            "city_id",
            "health_notes",
            "owner_declaration_at",
            "offer_type",
            "price",
            "auction_region_id",
            "auction_city_id",
            "auction_venue",
            "auction_starts_at",
            "contact_phone",
            "contact_call_enabled",
            "contact_whatsapp_enabled",
            "contact_consent_at",
            "settings_version",
            "content_hash",
            "submitted_at",
            "decided_at",
            "created_at",
            "updated_at"
          ],
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid"
            },
            "listing_id": {
              "type": "string",
              "format": "uuid"
            },
            "version_no": {
              "type": "integer",
              "minimum": 1
            },
            "status": {
              "enum": [
                "DRAFT",
                "SUBMITTED",
                "APPROVED",
                "REJECTED"
              ]
            },
            "title": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "description": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "breed_id": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ]
            },
            "breed_note": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "sex": {
              "anyOf": [
                {
                  "enum": [
                    "MALE",
                    "FEMALE"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "age_months": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ]
            },
            "color": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "region_id": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ]
            },
            "city_id": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ]
            },
            "health_notes": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "owner_declaration_at": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ]
            },
            "offer_type": {
              "anyOf": [
                {
                  "enum": [
                    "FIXED_PRICE",
                    "IN_PERSON_AUCTION"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "price": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "auction_region_id": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ]
            },
            "auction_city_id": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ]
            },
            "auction_venue": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "auction_starts_at": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ]
            },
            "contact_phone": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "contact_call_enabled": {
              "type": "boolean"
            },
            "contact_whatsapp_enabled": {
              "type": "boolean"
            },
            "contact_consent_at": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ]
            },
            "settings_version": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ]
            },
            "content_hash": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "submitted_at": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ]
            },
            "decided_at": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ]
            },
            "created_at": {
              "type": "string",
              "format": "date-time"
            },
            "updated_at": {
              "type": "string",
              "format": "date-time"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "media": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "status",
          "bucket",
          "object_path",
          "mime_type",
          "size_bytes",
          "width",
          "height",
          "duration_seconds",
          "sort_order",
          "is_cover",
          "failure_reason"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "kind": {
            "enum": [
              "IMAGE",
              "VIDEO"
            ]
          },
          "status": {
            "enum": [
              "PENDING",
              "READY",
              "FAILED"
            ]
          },
          "bucket": {
            "type": "string"
          },
          "object_path": {
            "type": "string"
          },
          "mime_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "size_bytes": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "width": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "height": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "duration_seconds": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "sort_order": {
            "type": "integer"
          },
          "is_cover": {
            "type": "boolean"
          },
          "failure_reason": {
            "anyOf": [
              {
                "enum": [
                  "EMPTY_FILE",
                  "UNSUPPORTED_TYPE",
                  "FILE_TOO_LARGE",
                  "CORRUPT_FILE",
                  "VIDEO_TOO_LONG",
                  "VIDEO_PROCESSING_UNAVAILABLE"
                ]
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    }
  }
}
