# انسخ هذا الملف إلى .env.local ولا تلتزم به.
# عنوان مشروع Supabase (التطوير) والمفتاح العام للعميل فقط (publishable / anon).
# ممنوع: مفتاح service_role أو أي مفتاح سري (sb_secret_...). اللوحة ترفض التشغيل بهما.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<publishable-or-anon-key>
